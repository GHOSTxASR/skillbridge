# Copy to .env.local (local) or set in Vercel → Project Settings → Environment Variables.
# Never commit real values. These are the only variables the app reads.

# Supabase: browser-exposed by design. Use the publishable/anon key ONLY,
# never the service-role / secret key. Data access is protected by RLS
# (supabase/migrations). Required at BUILD time: next build fails without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Groq: server-only (read in lib/ai/groq.ts). GROQ_API_KEY is required for AI;
# _1 and _2 are optional failover keys.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# Server-only. Must be a model your Groq account can access
# (GET https://api.groq.com/openai/v1/models). The code default does not exist on Groq.
GROQ_MODEL=

# Supabase secret key (sb_secret_...): SERVER-ONLY, never NEXT_PUBLIC_. Read by two server-only
# modules: lib/skills/roadmap-versions.ts (trusted learning-roadmap versions) and, only in SIH
# demo mode, lib/auth/demo-signup.ts. When it is empty the app still works; roadmap learning
# evidence is simply unavailable and demo mode stays off.
SUPABASE_SECRET_KEY=

# TEMPORARY SIH demo mode. Exactly "true" lets new accounts skip email verification: the
# server creates them (needs SUPABASE_SECRET_KEY). Leave EMPTY for production; empty restores
# the one-time email code. See docs/auth-email-verification.md.
SKILLBRIDGE_DEMO_AUTH=
